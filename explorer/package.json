{
  "name": "grivei-explorer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "npm run lint && npm run check --workspaces --if-present && npm run test:tooling",
    "test": "npm test --workspaces --if-present && npm run test:tooling",
    "test:tooling": "vitest run --pool=forks --maxWorkers=4",
    "lint": "eslint .",
    "codegen": "npm run codegen --workspace @grivei/contract",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "storybook:build": "storybook build -c .storybook -o storybook-static"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "storybook": "^10.6.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
